# ========================================================
# Email Intelligence Platform - Environment Configuration
# Fulfills Part 13.4
# ========================================================

# Django Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key
DJANGO_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production; SQLite fallback in dev)
DB_ENGINE=sqlite
POSTGRES_DB=email_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Outbound Probing & Crawler Identity (Part 6.8 & Part 21 D-20)
SMTP_PROBING_ENABLED=False
SMTP_PROBE_HELO=mail.emailintelligence.local
SMTP_PROBE_MAIL_FROM=verify@emailintelligence.local
CRAWLER_USER_AGENT=EmailIntelligencePlatformBot/1.0 (+https://emailintelligence.local/bot)

# Platform Limits (Part 21.1 D-08)
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_BULK_ROWS=10000
MAX_CRAWL_DEPTH=2
MAX_CRAWL_PAGES=30

